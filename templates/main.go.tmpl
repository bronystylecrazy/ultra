// {{.Name}} is one repo, one module, one binary. The binary is also the
// toolbox:
//
//	go run .                    # serve{{if .Web}} — a dev build serves NO frontend{{end}}
//	go run . routes             # the route table with scopes and contract flags
//	go run . graph              # the dependency graph + fingerprint
//	go run . doctor             # runtime self-diagnosis
//	go run . config reference   # the annotated config.toml, generated
//	go run . help
package main

import (
	"cmp"
	"embed"

	"github.com/bronystylecrazy/ultrastack/cli"
{{- if .From}}
	"github.com/bronystylecrazy/ultrastack/contrib/api"
{{- end}}
{{- if .Auth}}
	"github.com/bronystylecrazy/ultrastack/contrib/auth"
{{- end}}
	"github.com/bronystylecrazy/ultrastack/contrib/i18n"
{{- if .DB}}
	"github.com/bronystylecrazy/ultrastack/contrib/migrate"
{{- end}}
{{- if not .From}}
	"github.com/bronystylecrazy/ultrastack/contrib/otel"
{{- end}}
{{- if .DB}}
	"github.com/bronystylecrazy/ultrastack/contrib/pg"
{{- end}}
{{- if .From}}
	"github.com/bronystylecrazy/ultrastack/contrib/ultra"
{{- else}}
	"github.com/bronystylecrazy/ultrastack/contrib/zlog"
{{- end}}
{{- if or .Auth (not .From)}}
	"github.com/bronystylecrazy/di"
{{- end}}
{{- if .MQTT}}
	"github.com/bronystylecrazy/ultrastack/mqtt"
{{- end}}
{{- if not .From}}
	"github.com/bronystylecrazy/ultrastack/stack"
	"github.com/bronystylecrazy/ultrastack/web"
{{- end}}

	"{{.Module}}/internal/app"
)

// version is the ONE version string this product has. It stamps the OpenAPI
// document, the generated client and `./app version`, and `task build` sets it
// from git:
//
//	-ldflags "-X github.com/bronystylecrazy/ultrastack/cli.AppVersion=$(git describe …)"
//
// An unstamped build (`go run .`, `task dev:api`) falls back to the literal —
// so there is never a release where the binary and the document disagree
// because someone edited one constant and not the other.
var version = cmp.Or(cli.AppVersion, "0.1.0")

// The committed message catalogs: the wire carries stable codes, these files
// carry the words — one <locale>.toml per [i18n] locale, completeness gated
// by TestWiring. Problem messages render from them in the request's locale.
//
//go:embed messages/*.toml
var messages embed.FS
{{if .DB}}
// Persistence is central: ONE migration line for the whole product, never a
// per-feature directory. Add 00002_*.sql beside it as the schema grows.
//
//go:embed internal/db/migrations/*.sql
var migrations embed.FS
{{end}}
{{- if .From}}
// App is the root page — the whole product as one value, assigned exactly
// once. main runs it, the covenant validates it (stack.Validate(App)),
// tests compose it with overrides (di.TestApp(t, App, di.Swap[...](fake))),
// and e2e drives the built binary. Never reassign it: ultravet resolves the
// var only while it has a single writer.
//
// This product was reverse-scaffolded from {{.From}}, so it rides the TYPED
// api road — the legacy edge, fully supported. A forward product scaffolds
// onto handler-standard v3 (the web preset) instead.
var App = ultra.New( // the paved road: config + zerolog + Fiber on [http] +
	// /healthz, /ops/*, /metrics + traces/metrics (dormant until [otel] or
	// env configures an exporter)
	// The typed edge. Contracts are declared once, in Go, with logical
	// paths; OpenAPI, the TS client, the error codes and the dev proxy
	// are all derived. `go run . client --out web/src/lib/api`.
	api.Use(api.Info{Title: "{{.Name}}", Version: version}),
	api.Base("/v1"), // everything else belongs to the frontend
	api.Docs(),      // /docs, /docs/openapi.json
{{else}}
// App is the root page — the whole product as one value, assigned exactly
// once. main runs it, the covenant validates it (stack.Validate(App)),
// tests compose it with overrides (di.TestApp(t, App, di.Swap[...](fake))),
// and e2e drives the built binary. Never reassign it: ultravet resolves the
// var only while it has a single writer.
var App = di.Options(
	stack.Base, // the always-on floor: slog, lifecycle, /healthz detail — a VALUE, so cli.Run including it again is the harmless diamond
	zlog.Use(), // the zerolog engine on [log]: console in dev, JSON in prod, level hot-reloads
	// The observability waterfall, dormant until [otel] or env names an
	// exporter: spans + histograms for stack routes, trace-stamped logs,
	// runtime metrics.
	otel.Use(), otel.TraceRoutes, otel.TraceLogs, otel.MetricRoutes, otel.MetricRuntime,

	// Handler standard v3: raw fiber handlers on the paved road — the route
	// chain IS the contract. web.Use owns the server on [http], bundles the
	// conf machinery and /healthz + /ops/*, mounts every web.Provide'd
	// feature and every stack.Route, and contributes the `routes`, `openapi`
	// and `client` verbs.
	web.Use(web.Info{Title: "{{.Name}}", Version: version}),
{{end}}
	// Words at the edge: problem messages render from the catalogs in the
	// request's locale; codes stay the contract.
	i18n.Use(),                       // [i18n]: locales + default
	i18n.Resolve,                     // ?lang > cookie > Accept-Language > default{{if .Auth}} — before Protect so the user-preference rung sees the identity{{end}}
	i18n.Files(messages, "messages"), // the committed <locale>.toml catalogs
{{if .DB}}
	pg.Use(),      // [postgres]: the pool, dialed in Start
	migrate.Use(), // goose, applied before anything serves
	migrate.Files("app", migrations, "internal/db/migrations"), // "app": ONE central domain timeline; identifier-safe by construction
{{end}}
{{- if .Auth}}
	// Secure by default, both route kinds: every web route carries .Require
	// or .Public() (forgetting is boot error WEB0202, enforced by the preset
	// BEFORE any feature middleware), and auth.Protect guards the
	// stack.Routes — /healthz answers its bare verdict, /ops/* answer 401.
	auth.Use(),      // [auth]; in-memory stores until authpg.Use()
	auth.JWT(),         // Bearer validation; revocation lands next request
	auth.TokenRoutes,   // POST /auth/token (+/refresh) — API clients
	auth.LoginRoutes,   // POST /auth/login|logout — browsers (cookie)
	auth.SessionRoutes, // self-service session list/revoke
	auth.MeRoute,       // GET /auth/me: identity + effective permissions —
	                    // web/src/lib/auth{{if eq .Frontend "react"}}.ts{{else}}.svelte.ts{{end}} loads the session from it
	auth.Protect,       // enforcement for the stack routes (web enforces its own)
{{- if .MQTT}}
	auth.APIKeys(), // device credentials for the broker's CONNECT gate
{{- end}}

	// ───────────────────────── DEV ONLY — DELETE ME ─────────────────────────
	// ONE seeded user, so the login routes above actually work the minute
	// this boots: {{.DevUser}} / {{.DevPassword}} (holds "admin", which
	// [auth.roles] grants "*"). Without it the in-memory store is EMPTY and
	// every sign-in is "invalid credentials" forever — boot warns about
	// exactly that, and this line is why it does not.
	//
	// Replace with durable users before anyone else touches this:
	//     authpg.Use()   // users + API keys in Postgres (needs pg + migrate)
	// and DELETE this block in the same edit — authpg binds auth.UserStore too,
	// so leaving both is an ambiguity (DI0004), not a merge. That swap is why
	// `ultra add authpg` refuses: it is not one line.
	// A password in source is a password in git.
	di.Bind[auth.UserStore](func() *auth.MemUsers {
		return auth.NewMemUsers(auth.NewUser("{{.DevUser}}", "{{.DevPassword}}", "admin"))
	}),
	// ────────────────────────────────────────────────────────────────────────
{{end}}
{{- if .MQTT}}
	// The device edge: the product binary IS the broker, and features
	// subscribe with mqtt.Provide(NewEvents) — see `go run . topics` and
	// `go run . drops`.
	mqtt.Use(),
{{end}}
{{- if .Web}}
	SPA(), // dev: nothing at "/"; -tags embedspa: the built web/build
{{end}}
	// The product. app.go is the ONLY file that knows the feature list.
	app.Modules,
)

// Growth is one registration each, right here — and `ultra add <preset>`
// writes that line for you, into this call, before app.Modules:
//
//	ultra add jobs redis
//
// It is the same edit either way; the verb just prints where it landed. It
// refuses anything that is NOT one line (see the list below) rather than
// guessing. See the framework SKILL.md for the reference behind every line.
//
{{- if not .DB}}
//	pg.Use() + migrate.Use()   Postgres pool + embedded migrations
//	                           NOT `ultra add` — it needs internal/db/, so it
//	                           rides `ultra new --db`
{{- end}}
{{- if .Auth}}
//	authpg.Use()                  durable users + API keys in Postgres —
//	                              REPLACES the dev-seed block below, so it is a
//	                              hand edit, not `ultra add`
{{- else}}
//	auth.Use() + auth.Protect     identity + route enforcement (rides
//	                              `ultra new --auth`: it needs the login page)
{{- end}}
{{- if and .Auth (not .MQTT) (not .From)}}
//	mqtt.Use() + auth.APIKeys()   the embedded MQTT broker + feature Events
//	                              (github.com/bronystylecrazy/ultrastack/mqtt)
{{- end}}
//
// One line each, and `ultra add <name>` wires any of them:
//
//	jobs.Use()                    durable background jobs + cron
//	ws.Use()                      the realtime hub
//	rate.Use()                    identity-keyed rate limiting
//	cache.Use()                   in-process typed caches
//	redis.Use()                   the client — needs a [redis] url to BOOT
//	s3.Use()                      object storage — needs an [s3] endpoint to BOOT
//	console.Use()                 the ops console at /ops/console
//	audit.Use() · seed.Use() · notify.Use() · report.Use()

func main() { cli.Run(App) }
