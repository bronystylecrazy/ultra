<!-- ─────────────── DEV LOGIN — REPLACE IT, DO NOT DELETE IT ───────────────
     The minimum door into a product that enforces auth. Without a page like
     this one every route answers 401 and the UI has no way to say who it is,
     which is the worst kind of scaffold hole: everything builds, nothing is
     reachable.

     It signs in through the scaffold-owned session store ($lib/auth.svelte)
     — the cookie flavor, so the server sets an HttpOnly cookie, this tab
     holds nothing, and a reload stays signed in. +layout.ts sends anonymous
     visitors here.

     Replace it with YOUR login (branding, SSO, "forgot password", whatever
     the product needs) and keep +layout.ts pointing at wherever it lives.
     Unlike main.go's seeded user, this is not a block to delete: a product
     that enforces auth needs SOME login page. A PUBLIC app (docs, marketing)
     deletes the marked guard block in +layout.ts and keeps this page.
──────────────────────────────────────────────────────────────────────── -->
<script lang="ts">
	import { goto } from '$app/navigation';
	import { session } from '$lib/auth.svelte';
{{- if eq .DS "connected"}}
	import { Button } from '@connected/svelte-connected-design/button';
	import { Field } from '@connected/svelte-connected-design/field';
	import { Input } from '@connected/svelte-connected-design/input';
{{- end}}

	let username = $state('');
	let password = $state('');
	let error = $state('');
	let busy = $state(false);

	async function submit(e: SubmitEvent) {
		e.preventDefault();
		busy = true;
		error = '';
		try {
			// signIn() calls POST /auth/login and then /auth/me, so the store is
			// populated before the next route renders.
			await session.signIn({ username, password });
			await goto('/');
		} catch (err) {
			// The problem's OWN message: the server renders it from the
			// messages/*.toml catalogs in the request's locale
			// (auth.invalid_credentials and friends are keys there). Never
			// invent copy for a failure the API named.
			error = err instanceof Error ? err.message : String(err);
		} finally {
			busy = false;
		}
	}
</script>

{{if eq .DS "connected" -}}
<form class="mx-auto flex w-full max-w-sm flex-col gap-L p-XL" onsubmit={submit}>
	<h1 class="text-heading-S fg-primary">Sign in to {{.Name}}</h1>
	<Field label="{{.Login.Username}}">
		{#snippet children(control)}
			<Input {...control} bind:value={username} autocomplete="username" />
		{/snippet}
	</Field>
	<!-- The error rides the password field: Field owns the a11y wiring, and an
	     empty string is not an error. -->
	<Field label="{{.Login.Password}}" {error}>
		{#snippet children(control)}
			<Input {...control} bind:value={password} type="password" autocomplete="current-password" />
		{/snippet}
	</Field>
	<Button type="submit" loading={busy}>{{.Login.Submit}}</Button>
</form>
{{- else -}}
<form class="mx-auto flex w-full max-w-sm flex-col gap-4 p-6" onsubmit={submit}>
	<h1 class="text-xl font-semibold">Sign in to {{.Name}}</h1>
	<label class="flex flex-col gap-1">
		{{.Login.Username}}
		<input class="rounded border px-2 py-1" bind:value={username} autocomplete="username" />
	</label>
	<label class="flex flex-col gap-1">
		{{.Login.Password}}
		<input
			class="rounded border px-2 py-1"
			type="password"
			bind:value={password}
			autocomplete="current-password"
		/>
	</label>
	{#if error}
		<p class="text-red-600">{error}</p>
	{/if}
	<button class="rounded bg-black px-3 py-2 text-white disabled:opacity-50" type="submit" disabled={busy}>
		{{.Login.Submit}}
	</button>
</form>
{{- end}}
