import { sveltekit } from '@sveltejs/kit/vite';
import tailwindcss from '@tailwindcss/vite';
import { defineConfig } from 'vite';
import proxyPaths from './src/lib/api/vite.proxy.json';

// In production the SPA and the API share one origin (the single binary). In
// dev they are two ports, so vite forwards every prefix the backend claims —
// read from the same route table `go run . routes` prints, regenerated by
// `task gen`. That list is not hand-maintained.
//
// Neither is the target under `ultra dev`: it resolves the API's real addr
// (ULTRA_HTTP_ADDR > [http] addr > :8080) and exports ULTRA_DEV_API to this
// process, so moving the addr does not turn every API call into a 404. The
// literal below is only for a `bun dev` started on its own — it mirrors
// [http] addr, which is derived from the product name; change one and you
// change this line too.
const target = process.env.ULTRA_DEV_API ?? 'http://localhost:{{.HTTPPort}}';
const proxy = Object.fromEntries(
	Object.entries(proxyPaths).map(([p, o]) => [p, { target, ws: o.ws, changeOrigin: true }])
);

export default defineConfig({
	// tailwindcss() before sveltekit(): the CSS pipeline must be in place
	// before SvelteKit hands it a <style> block.
	plugins: [tailwindcss(), sveltekit()],
	server: { proxy }
});
