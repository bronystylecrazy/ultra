#!/usr/bin/env bun
/**
 * check-api-usage — the generated client IS the API surface.
 *
 * `task gen` writes a typed function, a TanStack hook and (where a request
 * validates) a forms.ts binding for every operation the Go contract declares.
 * None of that is enforceable by the compiler: a screen can ignore all of it,
 * `fetch('/v1/zones')` by hand, and pass svelte-check, `bun run build` and
 * `task test` while every 422 collapses into one generic toast. That product
 * ships, and its per-field error machinery is dead code.
 *
 * This is the gate. In PRODUCT files only (src/lib/api, src/lib/i18n and
 * src/lib/ui are generated or vocabulary, never call sites):
 *
 *   raw-fetch         (error)   fetch() at a URL literal starting with a prefix
 *                               the backend claims — read from
 *                               src/lib/api/vite.proxy.json, so the rule tracks
 *                               this product's real surface — or any
 *                               XMLHttpRequest, which a generated client never
 *                               leaves a reason to construct.
 *   hand-rolled-hook  (error)   createQuery/createMutation/useQuery/... called
 *                               straight from @tanstack, when the generated
 *                               <op>Query/<op>Mutation options factory is what
 *                               belongs inside it.
 *   swallowed-error   (warning) a try whose body calls the generated client and
 *                               whose catch throws the error away, while
 *                               forms.ts is sitting there ready to turn it into
 *                               per-field messages.
 *
 * PRECISION, deliberately: a URL built from a variable is invisible here, and
 * so is a hand-rolled call in a file this never reads — the gate is a floor,
 * not a proof. It errs the other way too: `createQuery(() => zonesQuery(req))`
 * is NOT flagged (composing a generated factory is the sanctioned escape), and
 * swallowed-error only WARNS, because a delete-with-a-toast legitimately has no
 * fields to bind and a noisy gate is a gate people delete.
 *
 * A deliberate escape goes in web/api-usage-allow.txt, and must say why.
 */
import { existsSync, readdirSync, readFileSync } from 'node:fs'
import { join, relative, sep } from 'node:path'
import { fileURLToPath } from 'node:url'
import { parse } from 'svelte/compiler'

const WEB = fileURLToPath(new URL('..', import.meta.url))
const API = join(WEB, 'src', 'lib', 'api')
const ALLOW_FILE = join(WEB, 'api-usage-allow.txt')

/** Where call sites live. */
const ROOTS = ['src/routes', 'src/lib']
/** Generated client, generated catalogs, and the design-system vocabulary. */
const SKIP = ['src/lib/api', 'src/lib/i18n', 'src/lib/ui']
/** The TanStack primitives the generated hooks are built out of. */
const PRIMITIVES = new Set([
  'createQuery',
  'createInfiniteQuery',
  'createMutation',
  'useQuery',
  'useInfiniteQuery',
  'useMutation',
])

type Rule = 'raw-fetch' | 'hand-rolled-hook' | 'swallowed-error'
type Finding = { rel: string; line: number; column: number; rule: Rule; detail: string }

const RULES: Record<Rule, { level: 'error' | 'warning'; fix: string }> = {
  'raw-fetch': {
    level: 'error',
    fix: "import the generated function or hook from '$lib/api' — it carries the base URL, the auth header, the 401 refresh-and-retry, and the typed Problem",
  },
  'hand-rolled-hook': {
    level: 'error',
    fix: "call the generated create<Op>Query / create<Op>Mutation from '$lib/api', or pass its <op>Query options factory into this primitive",
  },
  'swallowed-error': {
    level: 'warning',
    fix: "keep the error: `errs = fieldErrors(e); failed = formError(e)` from '$lib/api/forms' binds a 422 to <Field error={...}>",
  },
}

/** Prefixes the backend claims, from the same file vite proxies with. */
function apiPrefixes(): string[] {
  const p = join(API, 'vite.proxy.json')
  if (!existsSync(p)) return []
  return Object.keys(JSON.parse(readFileSync(p, 'utf8')))
}

/** Reads the allowlist: `<path>[:<rule>]  # why`, `#` comments, blanks. */
function readAllow(): { entries: Map<string, string>; bad: string[] } {
  const entries = new Map<string, string>()
  const bad: string[] = []
  if (!existsSync(ALLOW_FILE)) return { entries, bad }
  for (const line of readFileSync(ALLOW_FILE, 'utf8').split('\n')) {
    const s = line.trim()
    if (!s || s.startsWith('#')) continue
    const hash = s.indexOf('#')
    // The reason is the point of the file: an escape nobody justified is the
    // thing this gate exists to stop.
    if (hash < 0 || !s.slice(hash + 1).trim()) {
      bad.push(s)
      continue
    }
    entries.set(s.slice(0, hash).trim(), s.slice(hash + 1).trim())
  }
  return { entries, bad }
}

function sourceFiles(dir: string, out: string[] = []): string[] {
  if (!existsSync(dir)) return out
  for (const e of readdirSync(dir, { withFileTypes: true })) {
    if (e.name === 'node_modules' || e.name.startsWith('.')) continue
    const p = join(dir, e.name)
    if (e.isDirectory()) sourceFiles(p, out)
    else if (/\.(svelte|ts|js)$/.test(e.name) && !e.name.endsWith('.d.ts')) out.push(p)
  }
  return out
}

/** Byte offset → 1-based line/column, over one file's line starts. */
function locator(src: string) {
  const starts = [0]
  for (let i = 0; i < src.length; i++) if (src[i] === '\n') starts.push(i + 1)
  return (offset: number) => {
    let lo = 0
    let hi = starts.length - 1
    while (lo < hi) {
      const mid = (lo + hi + 1) >> 1
      if (starts[mid] <= offset) lo = mid
      else hi = mid - 1
    }
    return { line: lo + 1, column: offset - starts[lo] + 1 }
  }
}

/** Every node in a subtree, cycle-safe. */
function* nodes(root: any): Generator<any> {
  const seen = new WeakSet<object>()
  const stack = [root]
  while (stack.length) {
    const n = stack.pop()
    if (!n || typeof n !== 'object' || seen.has(n)) continue
    seen.add(n)
    if (!Array.isArray(n) && typeof n.type === 'string') yield n
    for (const key of Object.keys(n)) {
      // `parent` and `metadata` point back up or sideways into shared state.
      if (key === 'parent' || key === 'metadata') continue
      const v = (n as any)[key]
      if (v && typeof v === 'object') stack.push(v)
    }
  }
}

const isCallTo = (n: any, names: Set<string>) =>
  n.type === 'CallExpression' && n.callee?.type === 'Identifier' && names.has(n.callee.name)

/** The static head of a URL argument, or null when it is computed. */
function urlHead(arg: any): string | null {
  if (!arg) return null
  if (arg.type === 'Literal' && typeof arg.value === 'string') return arg.value
  if (arg.type === 'TemplateLiteral') return arg.quasis[0]?.value?.cooked ?? null
  return null
}

/** Does this URL point at the product's own API? An absolute URL counts only
 *  when its host is this machine — a third-party service that happens to serve
 *  /v1 is somebody else's contract. */
function hitsAPI(url: string | null, prefixes: string[]): boolean {
  if (!url) return false
  let path = url
  const abs = /^[a-z]+:\/\/([^/]*)(\/.*)?$/i.exec(url)
  if (abs) {
    if (!/^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$/.test(abs[1])) return false
    path = abs[2] ?? '/'
  }
  return prefixes.some((p) => path === p || path.startsWith(p + '/') || path.startsWith(p + '?'))
}

function scan(rel: string, src: string, prefixes: string[], hasForms: boolean, found: Finding[]) {
  // One parser for both shapes: a .ts file is a svelte script block with no
  // markup, so wrapping it gets the same TypeScript-aware ESTree back.
  const wrap = rel.endsWith('.svelte') ? '' : '<script lang="ts">\n'
  const ast: any = parse(wrap + src + (wrap ? '\n</script>' : ''), { modern: true, filename: rel })
  const at = locator(src)
  const push = (offset: number, rule: Rule, detail: string) =>
    found.push({ rel, ...at(Math.max(0, offset - wrap.length)), rule, detail })

  // Who is imported from where decides two of the three rules.
  const primitives = new Set<string>()
  const generated = new Set<string>()
  for (const n of nodes(ast)) {
    if (n.type !== 'ImportDeclaration' || typeof n.source?.value !== 'string') continue
    const from: string = n.source.value
    const tanstack = from.startsWith('@tanstack/')
    const client = from === '$lib/api' || from.startsWith('$lib/api/')
    if (!tanstack && !client) continue
    for (const s of n.specifiers ?? []) {
      const local = s.local?.name
      if (!local) continue
      if (client) generated.add(local)
      else if (PRIMITIVES.has(s.imported?.name ?? local)) primitives.add(local)
    }
  }
  const callsGenerated = (n: any) => {
    for (const inner of nodes(n)) if (isCallTo(inner, generated)) return true
    return false
  }

  for (const n of nodes(ast)) {
    if (n.type === 'NewExpression' && n.callee?.type === 'Identifier' && n.callee.name === 'XMLHttpRequest') {
      push(n.start, 'raw-fetch', 'new XMLHttpRequest()')
      continue
    }
    if (n.type === 'CallExpression') {
      const callee = n.callee
      // fetch(url) and window.fetch(url) — the URL literal is the evidence.
      const isFetch =
        (callee?.type === 'Identifier' && callee.name === 'fetch') ||
        (callee?.type === 'MemberExpression' && callee.property?.name === 'fetch')
      const url = isFetch ? urlHead(n.arguments?.[0]) : null
      if (hitsAPI(url, prefixes)) {
        push(n.start, 'raw-fetch', `fetch('${url}', …)`)
        continue
      }
      // A primitive holding anything but a generated options factory is a
      // hand-rolled hook — the queryKey and the queryFn are both guesses.
      if (isCallTo(n, primitives) && !callsGenerated(n)) {
        push(n.start, 'hand-rolled-hook', `${n.callee.name}(…)`)
      }
      continue
    }
    if (hasForms && n.type === 'TryStatement' && callsGenerated(n.block)) {
      const h = n.handler
      if (!h) continue
      const named = h.param?.type === 'Identifier' ? h.param.name : null
      const used =
        named !== null && [...nodes(h.body)].some((x) => x.type === 'Identifier' && x.name === named)
      if (!used) push((h.start ?? n.start) as number, 'swallowed-error', named ? `catch (${named}) { … }` : 'catch { … }')
    }
  }
}

// ---- run ---------------------------------------------------------------------

// No generated client means no hooks to prefer and no prefixes to police: this
// project has not run `task gen` yet, and demanding a surface that does not
// exist would be a wall, not a gate.
if (!existsSync(join(API, 'index.ts'))) {
  console.log('check-api-usage: no src/lib/api/index.ts — run `task gen` first. Skipped.')
  process.exit(0)
}

const prefixes = apiPrefixes()
const hasForms = existsSync(join(API, 'forms.ts'))
const { entries: allow, bad } = readAllow()
const used = new Set<string>()
const found: Finding[] = []

for (const root of ROOTS) {
  for (const abs of sourceFiles(join(WEB, root))) {
    const rel = relative(WEB, abs).split(sep).join('/')
    if (SKIP.some((s) => rel === s || rel.startsWith(s + '/'))) continue
    try {
      scan(rel, readFileSync(abs, 'utf8'), prefixes, hasForms, found)
    } catch (err) {
      // A file the parser rejects is svelte-check's failure to report.
      console.warn(`check-api-usage: skipped ${rel} (does not parse): ${(err as Error).message}`)
    }
  }
}

const flagged = found
  .filter((f) => {
    for (const key of [f.rel, `${f.rel}:${f.rule}`]) {
      if (allow.has(key)) {
        used.add(key)
        return false
      }
    }
    return true
  })
  .sort((a, b) => a.rel.localeCompare(b.rel) || a.line - b.line || a.column - b.column)
for (const key of allow.keys()) {
  if (!used.has(key)) console.log(`check-api-usage: note — api-usage-allow.txt no longer needs ${key}`)
}

const errors = flagged.filter((f) => RULES[f.rule].level === 'error')
const warnings = flagged.filter((f) => RULES[f.rule].level === 'warning')

const report = (f: Finding) => {
  const w = RULES[f.rule]
  const out = w.level === 'error' ? console.error : console.log
  out(`  ${f.rel}:${f.line}:${f.column}  [${f.rule}]`)
  out(`    ${f.detail}`)
  out(`    fix: ${w.fix}\n`)
}

for (const b of bad) {
  console.error(`check-api-usage: api-usage-allow.txt entry ${JSON.stringify(b)} has no reason.`)
  console.error('    Every escape says why, on the same line: `src/lib/x/y.ts  # upload progress needs XHR`\n')
}

if (errors.length) {
  console.error(`check-api-usage: ${errors.length} hand-rolled API call(s).\n`)
  errors.forEach(report)
}
if (warnings.length) {
  console.log(`check-api-usage: ${warnings.length} warning(s) — the generated error machinery is going unused.\n`)
  warnings.forEach(report)
}

if (errors.length === 0 && bad.length === 0) {
  console.log(
    `check-api-usage: every call goes through the generated client (${allow.size} allowlisted, ${warnings.length} warning(s)).`,
  )
  process.exit(0)
}
console.error(
  [
    "The generated hooks and forms.ts ARE the API surface. Declare the contract in Go,",
    'run `task contracts`, and import what it emits from `$lib/api` — the base URL, the',
    'auth header, the 401 retry, the typed Problem and the per-field 422 binding all',
    'come with it, and a contract change then breaks the CALL SITE instead of the user.',
    '',
    'A deliberate escape goes in web/api-usage-allow.txt, one per line, WITH the reason:',
    '  src/lib/upload/xhr.ts:raw-fetch  # upload progress events; fetch has none',
  ].join('\n'),
)
process.exit(1)
