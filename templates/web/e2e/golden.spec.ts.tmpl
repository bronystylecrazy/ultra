// No setup: `task e2e` runs `bun install` and fetches the chromium build the
// first time (a one-time ~100MB download), and skips with a note on a machine
// without bun/npx. By hand it is: cd web && bun install && bunx playwright install chromium.
//
// GROW this file; do not multiply it. Your product's ONE core flow belongs
// here — the flow whose breakage means the product is down. Everything
// narrower is a Go test one tier down: 100x faster, and it names the fix.
import { expect, test } from '@playwright/test';

test('the shell renders and the API answers', async ({ page, request }) => {
	// Fail loudly on an uncaught exception: a page that "loads" while its
	// hydration threw is the failure a curl 200 always misses.
	const crashes: string[] = [];
	page.on('pageerror', (err) => crashes.push(String(err)));

	// The API half of the sandwich.
	const health = await request.get('/healthz');
{{- if .Auth}}
	// auth.Protect guards ops too, so 401 IS the healthy anonymous answer —
	// the same claim main_test.go's boot smoke makes.
	expect(health.status()).toBe(401);
{{- else}}
	expect(health.ok()).toBeTruthy();
{{- end}}

	// The frontend half: the EMBEDDED build boots and hydrates.
	await page.goto('/');
	await expect(page.getByRole('heading', { name: '{{.Name}}' })).toBeVisible();
	expect(crashes).toEqual([]);
});

