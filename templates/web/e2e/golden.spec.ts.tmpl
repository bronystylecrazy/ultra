// THE golden path: ONE spec, the whole sandwich — the single binary serving
// the embedded SPA, driven by a real browser.
//
//	task e2e                                  # build → boot → run → kill
//	BASE_URL=https://staging.example task e2e # ...or a deployed instance
//
// No setup: `task e2e` runs `bun install` and fetches the chromium build the
// first time (a one-time ~100MB download), and skips with a note on a machine
// without bun. By hand it is: cd web && bun install && bunx playwright install chromium.
//
// GROW this file; do not multiply it. Your product's ONE core flow belongs
// here — the flow whose breakage means the product is down. Everything
// narrower is a Go test one tier down: 100x faster, and it names the fix.
import { expect, test } from '@playwright/test';

test('the shell renders and the API answers', async ({ page, request }) => {
	// Fail loudly on an uncaught exception: a page that "loads" while its
	// hydration threw is the failure a curl 200 always misses.
	const crashes: string[] = [];
	page.on('pageerror', (err) => crashes.push(String(err)));

	// The API half of the sandwich. The probe answer is public — the same
	// claim main_test.go's boot smoke makes.
	const health = await request.get('/healthz');
	expect(health.ok()).toBeTruthy();
{{- if .Auth}}
	// auth.Protect guards everything that says WHO, so 401 IS the healthy
	// anonymous answer from the identity route.
	const me = await request.get('/auth/me');
	expect(me.status()).toBe(401);
{{- end}}

{{- if .Auth}}

	// The frontend half: the EMBEDDED build boots, hydrates, and the auth
	// guard ({{if eq .Frontend "react"}}App.tsx{{else}}+layout.ts{{end}}) sends an anonymous visitor to the login page
	// rather than to a screen that can only 401.
	await page.goto('/');
	await expect(page).toHaveURL(/\/login$/);

	// Then in through the front door, with the user main.go seeds — the same
	// credentials `ultra new` printed. Point the run at real ones with
	// E2E_USER / E2E_PASS once the seed is gone.
	await page.getByLabel('{{.Login.Username}}').fill(process.env.E2E_USER ?? '{{.DevUser}}');
	await page.getByLabel('{{.Login.Password}}').fill(process.env.E2E_PASS ?? '{{.DevPassword}}');
	await page.getByRole('button', { name: '{{.Login.Submit}}' }).click();
{{- else}}

	// The frontend half: the EMBEDDED build boots and hydrates.
	await page.goto('/');
{{- end}}
	await expect(page.getByRole('heading', { name: '{{.Name}}' })).toBeVisible();
	expect(crashes).toEqual([]);
});

