// Package {{.Name}} — <one line describing what this feature owns>.
//
// RUNG 1 of the feature ladder: the whole feature on one page. It splits into
// the named files (api.go, events.go, store.go, errors.go) when content
// demands them — never before. RUNG 3 (a child package, one level) is for a
// feature past ~8 files or a second route prefix; `ultra vet` nudges (UV0009).
package {{.Name}}

import (
	"github.com/bronystylecrazy/ultrastack/di"
	"github.com/bronystylecrazy/ultrastack/web"
)

// Module is the front page of the feature: its whole wiring at a glance, as
// ONE value the assembly lists — never reassigned, never addressed. The name
// IS the package name (di.Pkg() self-names instead, if you prefer no string).
var Module = di.Module("{{.Name}}",
	// di.Provide(NewStore),
	web.Provide(NewAPI), // registration-checked: no Handle(web.Router) method = WEB0201
	// mqtt.Provide(NewEvents), // the bus surface is its OWN component (events.go)
)

// Scopes are contract surface: named constants, never literals at a call
// site (UV0011). [auth.roles] in config.toml grants them to roles.
const ReadScope = web.Scope("{{.Name}}.read")

// const WriteScope = web.Scope("{{.Name}}.write")

// Error codes are contracts: stable machine discriminators clients localize
// from. They ride web.Fail's problem envelope, land in x-error-codes and the
// client's typed error unions (declare them on routes with .Fails). Never
// rename a shipped code — add a new one.
const (
// CodeNotFound = "{{.Name}}.not_found"
// CodeBadID    = "{{.Name}}.bad_id"
)

// Sentinels are errors.Is targets for branching INSIDE the feature. Driver
// sentinels (pgx.ErrNoRows and friends) die in store.go — a store method
// translates them here, so handlers branch on the domain's vocabulary:
//
//	var ErrNotFound = errors.New("{{.Name}}: not found")

// API is the feature's HTTP surface: one component, constructed by DI like
// any other, holding the services its handlers need. One transport per
// struct — a bus surface is a second component (Events) with its own
// Handle(mqtt.Router).
type API struct {
	// store *Store
}

func NewAPI() *API { return &API{} }

