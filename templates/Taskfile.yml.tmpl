# machinery — maintained by ultra; you rarely edit this file.
# The same verbs in every product on the fleet — learn them once, and any
# repo answers to the same hands. Do not rename them; add new ones below.
version: '3'

tasks:
  dev:
    desc: "THE inner loop: infra up, watch, rebuild, graceful restart, fresh contracts, web HMR — one terminal (`ultra dev`)"
    cmds:
      - ultra dev

  dev:api:
    desc: Serve the API (a dev build serves NO frontend — that is the design)
    cmds:
      - go run .
{{if .Web}}
  dev:web:
    desc: The SvelteKit dev server; it proxies the contract paths to dev:api
    dir: web
    cmds:
      - bun run dev

  gen:
    desc: Regenerate the typed client from the Go contracts — never hand-edit it
    cmds:
      - go run . client --out web/src/lib/api
{{end}}
  contracts:
    desc: Refresh the COMMITTED derived artifacts — the fix TestContractDrift asks for
    cmds:
      - go run . openapi > openapi.json
{{- if .Web}}
      - go run . client --out web/src/lib/api
{{- end}}

  test:
    desc: The covenant first — wiring, then boot, then everything else
    cmds:
      # The run is TEED to .ultra/test.json (gitignored): the recorded run
      # `ultra trace` joins verified statuses against — trace never runs
      # tests itself. Want prose output? `go test ./...` directly.
      - mkdir -p .ultra
      - set -o pipefail; go test -json ./... | tee .ultra/test.json
{{if .Web}}
  check:
    desc: svelte-check + i18n coverage + API-usage gate — the frontend blast radius of a contract change
    dir: web
    cmds:
      - bun run check
{{end}}
  verify:
    desc: What CI asks for
    cmds:
      - task: test
{{- if .Web}}
      - task: check
{{- end}}

  # ONE version string reaches the binary, the OpenAPI document and the typed
  # client: main.go reads cli.AppVersion with a fallback, and every verb that
  # BUILDS stamps it from git. A tagged commit builds as v1.2.3; anything else
  # builds as the short hash, with -dirty when the tree is not clean. An
  # unstamped build (task dev:api, go run .) falls back to main.go's literal.
  build:
    desc: The single binary{{if .Web}} — the frontend builds first, then the embed{{end}}
    silent: true
    cmds:
      - |
        set -e
        VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
        STAMP="-X github.com/bronystylecrazy/ultrastack/cli.AppVersion=$VERSION"
{{- if .Web}}
        (cd web && bun run build)
        go build -tags embedspa -ldflags "$STAMP" -o bin/{{.Name}} .
{{- else}}
        go build -ldflags "$STAMP" -o bin/{{.Name}} .
{{- end}}
        echo "built bin/{{.Name}} $VERSION"

  run:
    desc: Build, then serve the single binary
    cmds:
      - task: build
      - ./bin/{{.Name}}
{{if .Web}}
  e2e:
    desc: The golden path in a real browser, against the real single binary
    silent: true # the recipe below is a script; echoing it twice helps no one
    cmds:
      - |
        # Degrades to a SKIP when the browser toolchain is absent: a machine
        # without bun must not go red for a tier it cannot run. `task verify`
        # deliberately does not call this — `task test` is the always-green set.
        # ONE guard: bun ships bunx, so there is no second runner to look for.
        command -v bun >/dev/null 2>&1 || { echo "task e2e: skipped — bun not found (install bun, then in web/: bun add -d @playwright/test)"; exit 0; }
        set -e
        # This verb BUILDS; playwright.config.ts boots and kills the binary
        # (Playwright owns the server's lifetime, so a failed run never leaves
        # one listening). With BASE_URL set the spec runs against that instance
        # and nothing local is built at all.
        if [ -z "$BASE_URL" ]; then
          echo "task e2e: building the frontend, then the embedspa binary"
          cd web && bun install && bun run build && cd ..
          # Stamped like `task build`: e2e drives the REAL binary, and a real
          # binary knows its own version.
          VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
          go build -tags embedspa \
            -ldflags "-X github.com/bronystylecrazy/ultrastack/cli.AppVersion=$VERSION" \
            -o bin/{{.Name}}-e2e .
        fi
        cd web
        # The browser build is a one-time ~100MB download, a no-op after that;
        # without it there is nothing to drive.
        bunx playwright install chromium
        bunx playwright test
{{end}}
