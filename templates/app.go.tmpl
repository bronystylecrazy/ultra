// Package app is the product: the ONLY file in the repo that knows the
// feature list. main.go lists app.Modules — the VALUE below, never a call;
// nothing else aggregates.
package app

{{if .Features}}import (
	"github.com/bronystylecrazy/ultrastack/di"

{{range .Features}}	"{{$.Module}}/internal/app/{{.}}"
{{end}})
{{else}}import "github.com/bronystylecrazy/ultrastack/di"
{{end}}

// Modules is the feature list. Every feature is exactly one line — its Module
// value, not a call:
//
//	var Modules = di.Group(
//	    zones.Module,
//	    violations.Module,
//	)
//
// Scaffold one with `ultra new feature <name>` — it lands at
// internal/app/<name>/<name>.go exporting Module, and this is where you add
// the line. (di.Group is registration grouping, the assembly's spelling of
// di.Options; it collects no values. A module var included twice — the
// diamond — registers once, by value identity.)
//
// The import law (v3): features MAY import sibling features, ONE direction —
// `ultra vet` lists the surface as note[UV0010]. A would-be cycle cannot
// compile, and wanting one is a design signal with three exits: move the
// shared logic down (internal/kind), publish an event, or merge the features.
// When you WANT compile-time decoupling instead, the seam lives here: the
// CONSUMER declares the interface it needs, and this file binds the two —
//
//	di.Alias[telemetry.Recorder, *violations.Store](),
//
// so the coupling is visible in one place and swappable in tests.
var Modules = di.Group(
{{- range .Features}}
	{{.}}.Module,
{{- end}}
)
