package main

import (
	"testing"

	"github.com/bronystylecrazy/ultrastack/contrib/testkit"
)

// TestSmoke is the standard checklist — run first in CI, fast and loud: the
// graph validates, the app boots, every component is healthy, every GET route
// answers < 500, shutdown is graceful, and no goroutines leak. If this passes,
// the product turns on.
func TestSmoke(t *testing.T) {
	t.Setenv("ULTRA_APP_ADDR", "127.0.0.1:0") // ephemeral port for tests
	testkit.Smoke(t, Modules()...)
}
