# sqlc reads the goose migrations as the schema (Down sections ignored) and
# emits ONE typed querier package for the whole product. Features hold repos
# built on it; they never hold a connection, and there is never a second
# generated package.
#
#   cd internal/db && sqlc generate
version: "2"
# `ultra` doubles as a sqlc process plugin: run by sqlc, it adds the half sqlc
# does not derive — gen.DB (pool + Atomic), q.Tx(), a keyset page wrapper per
# cursor query, a sentinel per unique constraint, and row factories under
# gen/factory for tests. It needs no arguments and no install beyond the
# `ultra` already on PATH.
plugins:
  - name: ultra
    process:
      cmd: ultra
sql:
  - engine: "postgresql"
    schema: "migrations"
    queries: "queries"
    codegen:
      - plugin: ultra
        out: "gen"
        # Type overrides must be stated HERE TOO, identically. sqlc resolves
        # `gen.go.overrides` inside its own Go codegen and never sends them to
        # a plugin — the CodeGenRequest carries this `options:` block and
        # nothing else about types. Leave the two lists in sync or the row
        # factories under gen/factory fill pgtype where sqlc emitted
        # uuid.UUID, and the generated package stops compiling.
        #options:
        #  overrides:
        #    - db_type: "uuid"
        #      go_type: "github.com/google/uuid.UUID"
        #    - db_type: "timestamptz"
        #      go_type: "time.Time"
    gen:
      go:
        package: "gen"
        out: "gen"
        sql_package: "pgx/v5"
        emit_pointers_for_null_types: true
        # Pointer rows: :one returns *Note, :many returns []*Note — the
        # handler standard's pointer-response law (*T out, nil only beside an
        # error) starts at the querier. The ultra plugin reads this line too
        # and spells gen/factory and the page wrappers to match.
        emit_result_struct_pointers: true
        # Overrides (uuid → uuid.UUID, timestamptz → time.Time) go on the
        # NON-NULL types only: `nullable: true` overrides make sqlc v1.31.1
        # emit duplicate imports. Wrap sqlc.narg() params at the call site.
        # Uncomment the twin block above at the same time.
        #overrides:
        #  - db_type: "uuid"
        #    go_type: "github.com/google/uuid.UUID"
        #  - db_type: "timestamptz"
        #    go_type: "time.Time"
