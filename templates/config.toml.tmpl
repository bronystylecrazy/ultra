# {{.Name}} — one file, each section bound to a typed struct.
#
# Env always wins over the file: ULTRA_<SECTION>_<FIELD> (ULTRA_LOG_LEVEL,
{{- if .DB}}
# ULTRA_POSTGRES_URL, {{if .Auth}}ULTRA_AUTH_JWT_SECRET, {{end}}...) — that is where secrets belong.
{{- else if .Auth}}
# ULTRA_AUTH_JWT_SECRET, ...) — that is where secrets belong.
{{- else}}
# ...) — that is where secrets belong.
{{- end}}
# Decoding is strict: an unknown key, or a section nothing consumes, is a
# boot error naming the section. Print the annotated reference anytime:
#
#   go run . config reference

[http]
addr = ":8080"   # ULTRA_HTTP_ADDR overrides

[log]
level = "info"   # debug|info|warn|error — retunes live on file change
format = "auto"  # console|json|auto
{{if .DB}}
[postgres]
url = "postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable"
{{end}}
{{- if .Auth}}
[auth]
idle = "1h"       # sliding window
absolute = "12h"  # hard cap per session
# secure_cookie = true   # require HTTPS — turn this on in production

[auth.jwt]
# The HS256 signing key for POST /auth/token — generated fresh for this
# product so it mints tokens on the first boot instead of answering
# auth.jwt_unconfigured. DEV SECRET: rotate it for production and keep it out
# of the file entirely there — ULTRA_AUTH_JWT_SECRET wins over this line.
secret = "{{.JWTSecret}}"

[auth.roles]
# role → permissions, hot-reloadable: edits apply without a restart. The
# seeded dev user in main.go holds "admin", so "*" is what makes it able to
# call everything while you build.
admin = ["*"]
{{end}}
