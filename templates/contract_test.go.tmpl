// The contract is DERIVED, and the derived artifacts are COMMITTED:
// openapi.json at the product root{{if .Web}}, plus the typed client under
// web/src/lib/api{{end}}. This file regenerates them from the running graph and
// diffs. Change a contract without refreshing and the test fails here with the
// diff — so every pull request shows its own blast radius instead of hiding it
// behind "regenerate later".
//
//	task contracts     # the refresh; then commit what it changed
//
// Never hand-edit an artifact: fix the Go contract and regenerate.

const (
	contractFile = "openapi.json"
	// refresh is the one command every failure below points at.
	refresh = "task contracts   (= go run . openapi > openapi.json{{if .Web}} && go run . client --out web/src/lib/api{{end}})"
)

// TestContractDrift: the OpenAPI document the code describes vs. the one the
// repository ships.
func TestContractDrift(t *testing.T) {
	got := openAPIDoc(t)

	committed, err := os.ReadFile(contractFile)
	if errors.Is(err, fs.ErrNotExist) {
		// Bootstrap, exactly once: a freshly scaffolded product has no
		// document yet (the scaffold cannot run a binary it has only just
		// written). Write it and PASS — from the moment it is committed this
		// is a gate, and `git status` shows what to add.
		if err := os.WriteFile(contractFile, got, 0o644); err != nil {
			t.Fatal(err)
		}
		t.Logf("wrote %s from the current contracts — commit it: git add %s", contractFile, contractFile)
		return
	}
	if err != nil {
		t.Fatal(err)
	}
	want, err := normalizeJSON(committed)
	if err != nil {
		t.Fatalf("%s is not valid JSON (%v) — regenerate it: %s", contractFile, err, refresh)
	}
	if bytes.Equal(want, got) {
		return
	}
	t.Fatalf("the API contract changed but %s was not regenerated:\n%s\nrefresh:\n  %s",
		contractFile, contractSummary(want, got), refresh)
}

// openAPIDoc runs the product's own `openapi` command in-process — the same
// code path `go run . openapi` takes — and returns the normalized document.
func openAPIDoc(t *testing.T) []byte {
	t.Helper()
	code, out, errOut := cli.Test([]string{"openapi"}, App)
	if code != 0 {
		t.Fatalf("go run . openapi failed (%d):\n%s", code, errOut)
	}
	doc, err := normalizeJSON([]byte(out))
	if err != nil {
		t.Fatalf("openapi did not print JSON: %v\n%s", err, out)
	}
	return doc
}

// normalizeJSON re-encodes a document so the comparison is about CONTENT:
// object keys land in sorted order (encoding/json sorts map keys) with one
// fixed indentation and one trailing newline, so an editor's whitespace or a
// pretty-printer's mood can never fail this test.
func normalizeJSON(b []byte) ([]byte, error) {
	var v any
	if err := json.Unmarshal(b, &v); err != nil {
		return nil, err
	}
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetIndent("", "  ")
	if err := enc.Encode(v); err != nil {
		return nil, err
	}
	return buf.Bytes(), nil
}

// contractSummary renders the difference the way a reviewer reads it: which
// operations appeared, vanished, or were renamed. When the operation set is
// unchanged (a schema, a response, a parameter moved instead), it falls back
// to a capped line diff of the pretty-printed documents.
func contractSummary(want, got []byte) string {
	wantOps, gotOps := operations(want), operations(got)
	keys := make([]string, 0, len(wantOps)+len(gotOps))
	for k := range wantOps {
		keys = append(keys, k)
	}
	for k := range gotOps {
		if _, ok := wantOps[k]; !ok {
			keys = append(keys, k)
		}
	}
	sort.Strings(keys)

	var b strings.Builder
	for _, k := range keys {
		w, inWant := wantOps[k]
		g, inGot := gotOps[k]
		switch {
		case !inWant:
			fmt.Fprintf(&b, "  + %s  (%s)\n", k, g)
		case !inGot:
			fmt.Fprintf(&b, "  - %s  (%s)\n", k, w)
		case w != g:
			fmt.Fprintf(&b, "  ~ %s  operationId %s → %s\n", k, w, g)
		}
	}
	if b.Len() == 0 {
		b.WriteString(lineDiff(want, got))
	}
	return b.String()
}

// operations flattens paths → "METHOD /path" → operationId. Anything under a
// path item that is not an operation object (a summary string, a shared
// parameter list, a vendor extension) simply does not unmarshal, and is
// skipped rather than fought.
func operations(doc []byte) map[string]string {
	var parsed struct {
		Paths map[string]map[string]json.RawMessage `json:"paths"`
	}
	ops := map[string]string{}
	if err := json.Unmarshal(doc, &parsed); err != nil {
		return ops
	}
	for path, item := range parsed.Paths {
		for method, raw := range item {
			var op struct {
				OperationID string `json:"operationId"`
			}
			if err := json.Unmarshal(raw, &op); err != nil {
				continue
			}
			ops[strings.ToUpper(method)+" "+path] = op.OperationID
		}
	}
	return ops
}

// lineDiff reports the first differing lines, capped — enough to recognize the
// change, never a wall of JSON.
func lineDiff(want, got []byte) string {
	w := strings.Split(string(want), "\n")
	g := strings.Split(string(got), "\n")
	at := func(lines []string, i int) string {
		if i < len(lines) {
			return lines[i]
		}
		return ""
	}
	var b strings.Builder
	shown := 0
	for i := 0; i < len(w) || i < len(g); i++ {
		lw, lg := at(w, i), at(g, i)
		if lw == lg {
			continue
		}
		if shown == 8 {
			fmt.Fprintf(&b, "  … and more\n")
			break
		}
		fmt.Fprintf(&b, "  %d: -%s\n  %d: +%s\n", i+1, strings.TrimRight(lw, " "), i+1, strings.TrimRight(lg, " "))
		shown++
	}
	return b.String()
}
