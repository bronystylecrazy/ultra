// clientDir holds the generated TypeScript client. It is committed for the
// same reason openapi.json is: the diff is the contract's blast radius on the
// frontend, reviewed with the change that caused it.
const clientDir = "web/src/lib/api"

// TestClientDrift: the typed client the contracts imply vs. the one the
// repository ships. Same gate, other end of the wire.
func TestClientDrift(t *testing.T) {
	// Bootstrap: a fresh scaffold ships a seed dev proxy and nothing else, so
	// the first run GENERATES the client in place and passes. Commit it, and
	// every later run is a diff.
	if _, err := os.Stat(filepath.Join(clientDir, "common.ts")); errors.Is(err, fs.ErrNotExist) {
		generateClient(t, clientDir)
		t.Logf("generated %s from the current contracts — commit it: git add %s", clientDir, clientDir)
		return
	}

	fresh := t.TempDir()
	generateClient(t, fresh)

	committed := treeOf(t, clientDir)
	generated := treeOf(t, fresh)

	var added, removed, changed []string
	for name, body := range generated {
		switch old, ok := committed[name]; {
		case !ok:
			added = append(added, name)
		case old != body:
			changed = append(changed, name)
		}
	}
	for name := range committed {
		if _, ok := generated[name]; !ok {
			removed = append(removed, name)
		}
	}
	if len(added)+len(removed)+len(changed) == 0 {
		return
	}
	var b strings.Builder
	report := func(mark string, files []string) {
		sort.Strings(files)
		for _, f := range files {
			fmt.Fprintf(&b, "  %s %s/%s\n", mark, clientDir, f)
		}
	}
	report("+", added)
	report("-", removed)
	report("~", changed)
	t.Fatalf("the contracts changed but %s was not regenerated:\n%s\nrefresh:\n  %s",
		clientDir, b.String(), refresh)
}

// generateClient runs the product's own `client` command in-process.
func generateClient(t *testing.T, out string) {
	t.Helper()
	code, _, errOut := cli.Test([]string{"client", "--out", out}, App)
	if code != 0 {
		t.Fatalf("go run . client --out %s failed (%d):\n%s", out, code, errOut)
	}
}

// treeOf reads a directory into path → content. .gitkeep is the scaffold's
// placeholder, not a generated file: it is never part of the comparison.
func treeOf(t *testing.T, dir string) map[string]string {
	t.Helper()
	files := map[string]string{}
	err := filepath.WalkDir(dir, func(p string, e fs.DirEntry, err error) error {
		if err != nil || e.IsDir() || e.Name() == ".gitkeep" {
			return err
		}
		b, err := os.ReadFile(p)
		if err != nil {
			return err
		}
		rel, err := filepath.Rel(dir, p)
		if err != nil {
			return err
		}
		files[filepath.ToSlash(rel)] = string(b)
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	return files
}
