package main

import (
	"testing"

	"github.com/bronystylecrazy/ultrastack/cli"
	"github.com/stretchr/testify/require"
)

// TestSanity_API guards the typed API contract: the sample operation is carried
// in the generated OpenAPI 3.1 document, ready for `client --out` to build the
// frontend. Fast, shallow, no containers.
//
// TODO: add a contract sanity per operation you declare (an error shape, a
// pagination cursor, a permission on a write op).
func TestSanity_API(t *testing.T) {
	code, out, errOut := cli.Test([]string{"openapi"}, Modules()...)
	require.Equal(t, 0, code, errOut)
	require.Contains(t, out, "/hello")
	require.Contains(t, out, "3.1.0")
}
