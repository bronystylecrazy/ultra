// TestWiring is the covenant: if this passes, main boots. Every wiring
// mistake — a missing provider, an ambiguity, a captive scoped dependency —
// fails here with the fix in the error text. Read the error; never guess.
// One run reports EVERY independent defect, so fix the whole list at once.
// `ultra vet ./...` proves the same statically, before anything runs.
func TestWiring(t *testing.T) {
	if err := stack.Validate(App); err != nil {
		t.Fatal(err)
	}
}

// TestBoot is the boot smoke: the same App, started for real on a random
// port (":0" — never a fixed port in a test), answering one request.
func TestBoot(t *testing.T) {
{{- if .DB}}
	requirePostgres(t)
{{- end}}
{{- if .From}}
	app := di.TestApp(t, App, di.Supply(fib.Addr(":0")))
{{- else}}
	app := di.TestApp(t, App, di.Supply(web.Addr(":0")))
{{- end}}
	if err := app.ConstructAll(); err != nil {
		t.Fatal(err)
	}
	ctx := context.Background()
	if err := app.Start(ctx); err != nil {
		t.Fatal(err)
	}
	defer app.Stop(ctx)

{{if .From}}	base := "http://" + di.MustGet[*fib.Server](app).Addr()
{{else}}	base := "http://" + di.MustGet[*web.Server](app).Addr()
{{end}}	resp, err := http.Get(base + "/healthz")
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()
{{- if .Auth}}
	// auth.Protect guards the stack routes, and /healthz stays reachable: a
	// probe reads the STATUS CODE, so an anonymous caller gets the terse
	// verdict (200 ok, 503 degraded) and nothing else. The component
	// breakdown — names, errors, causes — answers only a verified caller.
	// /ops/* stay 401.
	if resp.StatusCode != http.StatusOK {
		t.Fatalf("healthz: got %d, want 200 (the probe answer is public; detail is not)", resp.StatusCode)
	}
	ops, err := http.Get(base + "/ops/graph")
	if err != nil {
		t.Fatal(err)
	}
	ops.Body.Close()
	if ops.StatusCode != http.StatusUnauthorized {
		t.Fatalf("ops/graph: got %d, want 401 (the graph is not a probe)", ops.StatusCode)
	}

	// ...and something can actually get IN. A product whose login routes are
	// mounted over an empty user store, or whose [auth.jwt] secret is missing,
	// boots perfectly and can never be signed in to — so the boot smoke proves
	// a real sign-in, not just a 401. When you delete the dev seed from main.go
	// (as you must), delete this too.
	tok, err := http.Post(base+"/auth/token", "application/json",
		strings.NewReader(`{"username":"{{.DevUser}}","password":"{{.DevPassword}}"}`))
	if err != nil {
		t.Fatal(err)
	}
	defer tok.Body.Close()
	if tok.StatusCode != http.StatusOK {
		t.Fatalf("POST /auth/token with the dev seed: got %d, want 200 — the scaffolded "+
			"product must be loginnable (check the seed in main.go and [auth.jwt] secret)", tok.StatusCode)
	}
{{- else}}
	if resp.StatusCode != http.StatusOK {
		t.Fatalf("healthz: got %d, want 200", resp.StatusCode)
	}
{{- end}}
}
{{if .DB}}
// requirePostgres skips the boot smoke when nothing is listening at the
// configured [postgres] address — a real boot dials the pool and applies
// the migrations before it serves. Nothing there is a skip with the fix;
// something there that then fails to boot is a REAL failure, never a skip.
// Real engines under load belong one tier up, in tests/integration/ with
// testkit.Postgres(t), so this tier stays container-free.
func requirePostgres(t *testing.T) {
	t.Helper()
	cfg := conf.MustLoadAt[pg.Config]("", pg.DefaultSection) // file + ULTRA_POSTGRES_URL
	u, err := url.Parse(cfg.URL)
	if err != nil {
		t.Fatalf("[postgres] url is not a URL: %v", err)
	}
	c, err := net.DialTimeout("tcp", u.Host, 500*time.Millisecond)
	if err != nil {
		t.Skipf("boot needs Postgres at %s (%v) — start it, or point ULTRA_POSTGRES_URL elsewhere", u.Host, err)
	}
	c.Close()
}
{{end}}
