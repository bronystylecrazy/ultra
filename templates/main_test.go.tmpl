// TestWiring is the covenant: if this passes, main boots. Every wiring
// mistake — a missing provider, an ambiguity, a captive scoped dependency —
// fails here with the fix in the error text. Read the error; never guess.
// One run reports EVERY independent defect, so fix the whole list at once.
// `ultra vet ./...` proves the same statically, before anything runs.
func TestWiring(t *testing.T) {
	if err := stack.Validate(App); err != nil {
		t.Fatal(err)
	}
}

// TestBoot is the boot smoke: the same App, started for real on a random
// port (":0" — never a fixed port in a test), answering one request.
func TestBoot(t *testing.T) {
{{- if .DB}}
	requirePostgres(t)
{{- end}}
	app := di.TestApp(t, App, di.Supply(stack.Addr(":0")))
	if err := app.ConstructAll(); err != nil {
		t.Fatal(err)
	}
	ctx := context.Background()
	if err := app.Start(ctx); err != nil {
		t.Fatal(err)
	}
	defer app.Stop(ctx)

	resp, err := http.Get("http://" + di.MustGet[*stack.Server](app).Addr() + "/healthz")
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()
{{- if .Auth}}
	// auth.Protect is wired, and it is secure-by-default all the way down:
	// /healthz answers 401 to an anonymous caller. If your load balancer
	// probes health unauthenticated, that is a decision to make here — not
	// a surprise to discover at 3am.
	if resp.StatusCode != http.StatusUnauthorized {
		t.Fatalf("healthz: got %d, want 401 (auth.Protect guards ops too)", resp.StatusCode)
	}
{{- else}}
	if resp.StatusCode != http.StatusOK {
		t.Fatalf("healthz: got %d, want 200", resp.StatusCode)
	}
{{- end}}
}
{{if .DB}}
// requirePostgres skips the boot smoke when nothing is listening at the
// configured [postgres] address — a real boot dials the pool and applies
// the migrations before it serves. Nothing there is a skip with the fix;
// something there that then fails to boot is a REAL failure, never a skip.
// Real engines under load belong one tier up, in tests/integration/ with
// testkit.Postgres(t), so this tier stays container-free.
func requirePostgres(t *testing.T) {
	t.Helper()
	cfg := conf.MustLoadAt[pg.Config]("", pg.DefaultSection) // file + ULTRA_POSTGRES_URL
	u, err := url.Parse(cfg.URL)
	if err != nil {
		t.Fatalf("[postgres] url is not a URL: %v", err)
	}
	c, err := net.DialTimeout("tcp", u.Host, 500*time.Millisecond)
	if err != nil {
		t.Skipf("boot needs Postgres at %s (%v) — start it, or point ULTRA_POSTGRES_URL elsewhere", u.Host, err)
	}
	c.Close()
}
{{end}}
