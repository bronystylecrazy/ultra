package main

import (
	"context"
	"encoding/json"
	"net/http"
	"strings"
	"testing"

	"github.com/bronystylecrazy/ultrastack/cli"
	"github.com/bronystylecrazy/ultrastack/contrib/fib"
	"github.com/bronystylecrazy/ultrastack/di"
	"github.com/bronystylecrazy/ultrastack/stack"
)

// The covenant in CI: if this passes, main boots. Every wiring mistake —
// missing provider, ambiguity, captive scoped dep — fails here with the
// fix in the error text. (ultra vet ./... catches the same statically.)
func TestWiring(t *testing.T) {
	if err := stack.Validate(Modules()...); err != nil {
		t.Fatal(err)
	}
}

func TestBootAndServe(t *testing.T) {
	t.Setenv("ULTRA_APP_ADDR", "127.0.0.1:0") // random port for tests

	app, err := stack.New(Modules()...)
	if err != nil {
		t.Fatal(err)
	}
	if err := app.Start(context.Background()); err != nil {
		t.Fatal(err)
	}
	defer app.Stop(context.Background())

	base := "http://" + di.MustGet[*fib.Server](app).Addr()

	// The typed sample operation serves JSON.
	resp, err := http.Get(base + "/hello")
	if err != nil {
		t.Fatal(err)
	}
	var hello Hello
	json.NewDecoder(resp.Body).Decode(&hello)
	resp.Body.Close()
	if resp.StatusCode != 200 || !strings.Contains(hello.Message, "hello") {
		t.Fatalf("hello operation: %d %+v", resp.StatusCode, hello)
	}

	// Auth is live: ops endpoints require authentication by default.
	resp2, err := http.Get(base + "/healthz")
	if err != nil {
		t.Fatal(err)
	}
	resp2.Body.Close()
	if resp2.StatusCode != http.StatusUnauthorized {
		t.Fatalf("healthz must require auth, got %d", resp2.StatusCode)
	}
}

// The toolbox works, and the API contract is in it: openapi carries the
// sample operation, ready for `client --out` to generate the frontend.
func TestToolbox(t *testing.T) {
	code, out, errOut := cli.Test([]string{"openapi"}, Modules()...)
	if code != 0 {
		t.Fatalf("openapi failed: %s", errOut)
	}
	if !strings.Contains(out, "hello.get") || !strings.Contains(out, "3.1.0") {
		t.Fatalf("openapi must carry the sample operation:\n%s", out)
	}
}
