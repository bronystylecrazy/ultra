package main

import (
	"context"
	"net/http"
	"testing"

	"github.com/bronystylecrazy/ultrastack/contrib/fib"
	"github.com/bronystylecrazy/ultrastack/di"
	"github.com/bronystylecrazy/ultrastack/stack"
	"github.com/stretchr/testify/require"
)

// TestSanity_Auth guards one known-tricky invariant: the auth boundary is live
// — a protected route rejects an anonymous caller. A sanity check is fast,
// shallow, container-free, and finishes well under 5s (require, not assert:
// the first failure stops the test rather than cascading).
//
// TODO: extend with this product's real permission/role boundaries as it grows
// (a "policy:owner" route, a role that must NOT reach admin data).
func TestSanity_Auth(t *testing.T) {
	t.Setenv("ULTRA_APP_ADDR", "127.0.0.1:0")

	app, err := stack.New(Modules()...)
	require.NoError(t, err)
	require.NoError(t, app.Start(context.Background()))
	defer app.Stop(context.Background())

	base := "http://" + di.MustGet[*fib.Server](app).Addr()
	resp, err := http.Get(base + "/healthz")
	require.NoError(t, err)
	resp.Body.Close()
	// Ops endpoints are authenticated by default; anonymous is rejected.
	require.Equal(t, http.StatusUnauthorized, resp.StatusCode)
}
