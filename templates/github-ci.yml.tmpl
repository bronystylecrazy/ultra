      # Binary reuse (build once, share with testkit.Product/e2e tests):
      #   - name: e2e-with-prebuilt-binary
      #     run: |
      #       go build -o /tmp/{{.Name}} .
      #       ULTRA_TEST_BINARY=/tmp/{{.Name}} go test ./e2e/...
