# The English catalog. The wire carries stable codes; these files carry the
# words — the message key IS the error code (one taxonomy), and `{param}`
# names must match the problem's params. A key missing from one locale fails
# TestWiring (I18N0202). Problem messages render from here in the request's
# locale, so the frontend shows the server's words — never invented copy.

"app.greeting" = "Welcome to {{.Name}}, {name}"
{{- if .Auth}}
# contrib/auth's own codes, so a rejected sign-in reads as words — on the wire
# for an API client, and through localize() on the login page.
"auth.invalid_credentials" = "Wrong username or password"
"auth.rate_limited"        = "Too many attempts — wait a moment and try again"
"auth.required"            = "Sign in to continue"
{{end}}
# Framework codes a problem response localizes through (add your feature's
# errors.go codes here as they ship):
"request.invalid"     = "The request failed validation"
"validation.required" = "{field} is required"
"validation.min"      = "{field} is below the minimum of {limit}"
"validation.max"      = "{field} is above the maximum of {limit}"
"validation.email"    = "{field} must be an email address"
"internal"            = "Something went wrong on our side"
