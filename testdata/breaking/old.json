{
  "openapi": "3.1.0",
  "info": {
    "title": "Notes",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin": {
      "get": {
        "operationId": "adminPing",
        "tags": ["admin"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}}}}}
          }
        }
      }
    },
    "/v1/annotations": {
      "post": {
        "operationId": "createAnnotation",
        "tags": ["annotations"],
        "responses": {
          "201": {
            "description": "Created",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"id": {"type": "string"}}}}}
          }
        }
      }
    },
    "/v1/drafts": {
      "post": {
        "operationId": "createDraft",
        "tags": ["drafts"],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"title": {"type": "string"}}}}}
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"id": {"type": "string"}}}}}
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "healthCheck",
        "tags": ["ops"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}}}}}
          }
        }
      }
    },
    "/v1/notes": {
      "get": {
        "operationId": "listNotes",
        "tags": ["notes"],
        "parameters": [
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotePage"}}}
          },
          "400": {
            "description": "Bad Request",
            "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}},
            "x-error-codes": ["request.param"]
          },
          "500": {
            "description": "Internal Server Error",
            "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}},
            "x-error-codes": ["internal"]
          }
        }
      },
      "post": {
        "operationId": "createNote",
        "tags": ["notes"],
        "parameters": [
          {"name": "dryRun", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "legacyMode", "in": "query", "required": false, "schema": {"type": "boolean"}},
          {"name": "page", "in": "query", "required": false, "schema": {"type": "integer"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "body": {"type": "string"},
              "slug": {"type": "string"},
              "kind": {"type": "string", "enum": ["draft", "published", "archived"]},
              "legacyRef": {"type": "string"},
              "weight": {"type": "string"},
              "note": {"anyOf": [{"type": "string"}, {"type": "null"}]},
              "tag": {"type": "string"},
              "visibility": {"type": "string"},
              "format": {"type": "string", "enum": ["md", "html"]}
            },
            "required": ["title", "slug"]
          }}}
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatedNote"}}}
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}},
            "x-error-codes": ["request.invalid"]
          }
        }
      }
    },
    "/v1/notes/{id}": {
      "delete": {
        "operationId": "deleteNote",
        "tags": ["notes"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"204": {"description": "No Content"}}
      },
      "patch": {
        "operationId": "updateNote",
        "tags": ["notes"],
        "security": [{"session": []}, {"apiKey": []}],
        "x-required-permission": "notes.write",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatedNote"}}}
          }
        }
      }
    },
    "/v1/notes/{id}/poke": {
      "post": {
        "operationId": "pokeNote",
        "tags": ["notes"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"reason": {"type": "string"}}}}}
        },
        "responses": {"204": {"description": "No Content"}}
      }
    },
    "/v1/notes/{id}/touch": {
      "post": {
        "operationId": "touchNote",
        "tags": ["notes"],
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"204": {"description": "No Content"}}
      }
    },
    "/v1/ping": {
      "get": {
        "operationId": "pingCheck",
        "tags": ["ops"],
        "responses": {"204": {"description": "No Content"}}
      }
    },
    "/v1/public": {
      "get": {
        "operationId": "publicize",
        "tags": ["ops"],
        "security": [{"session": []}, {"apiKey": []}],
        "x-required-permission": "ops.read",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"ok": {"type": "boolean"}}}}}
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "operationId": "getStats",
        "tags": ["ops"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"count": {"type": "integer"}}}}}
          }
        }
      }
    },
    "/v1/tags": {
      "get": {
        "operationId": "listTags",
        "tags": ["tags"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"names": {"type": "array", "items": {"type": "string"}}}}}}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatedNote": {
        "type": "object",
        "properties": {"id": {"type": "string"}},
        "required": ["id"]
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "active"]},
          "shape": {"oneOf": [{"type": "string"}, {"type": "integer"}]}
        },
        "required": ["id", "title"]
      },
      "NotePage": {
        "type": "object",
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Note"}},
          "cursor": {"type": "string"},
          "nextCursor": {"type": "string"},
          "total": {"type": "integer"},
          "generatedAt": {"type": "string", "format": "date-time"},
          "author": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "tier": {"type": "string", "enum": ["gold", "silver"]},
          "region": {"type": "string"},
          "kind": {"type": "string"}
        },
        "required": ["items", "cursor", "total", "generatedAt"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "integer"}
        },
        "required": ["code", "status"]
      }
    },
    "securitySchemes": {
      "apiKey": {"type": "http", "scheme": "bearer"},
      "session": {"type": "apiKey", "in": "cookie", "name": "ultra_session"}
    }
  }
}
